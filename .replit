modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm start"
workdir = "apps/app"
entrypoint = "apps/app/server.js"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm --workspace apps/app run build"]
run = ["sh", "-c", "npm --workspace apps/app run start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DEMO_MODE=true LEAD_SCORING_ENABLED=true VITE_LEAD_SCORING_ENABLED=true BOOKING_ENABLED=true VITE_BOOKING_ENABLED=true EMAIL_TRANSPORT=log npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_sendgrid:1.0.0", "javascript_object_storage:1.0.0", "javascript_database:1.0.0", "javascript_websocket:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_mem_db:1.0.0", "javascript_stripe:1.0.0"]
expertMode = true
