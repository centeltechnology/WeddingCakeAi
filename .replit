modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm start"
workdir = "apps/app"
entrypoint = "apps/app/server.js"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm --workspace apps/app run build"]
run = ["sh", "-c", "npm --workspace apps/app run start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 35217
externalPort = 3003

[[ports]]
localPort = 36849
externalPort = 5000

[[ports]]
localPort = 37703
externalPort = 3002

[[ports]]
localPort = 37997
externalPort = 6800

[[ports]]
localPort = 38173
externalPort = 3001

[[ports]]
localPort = 38853
externalPort = 8081

[[ports]]
localPort = 41309
externalPort = 8080

[[ports]]
localPort = 41385
externalPort = 8000

[[ports]]
localPort = 41945
externalPort = 5173

[[ports]]
localPort = 42687
externalPort = 3000

[[ports]]
localPort = 44047
externalPort = 4200

[[ports]]
localPort = 44733
externalPort = 8099

[[ports]]
localPort = 45209
externalPort = 9000

[[ports]]
localPort = 45501
externalPort = 8008

[[ports]]
localPort = 46815
externalPort = 6000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "LEAD_SCORING_ENABLED=true VITE_LEAD_SCORING_ENABLED=true BOOKING_ENABLED=true VITE_BOOKING_ENABLED=true npm run dev"
waitForPort = 5000

[agent]
integrations = [
  "javascript_sendgrid==1.0.0",
  "javascript_object_storage==1.0.0",
  "javascript_database==1.0.0",
  "javascript_websocket==1.0.0",
  "javascript_log_in_with_replit==1.0.0",
  "javascript_mem_db==1.0.0",
  "javascript_stripe==1.0.0",
]
expertMode = true
